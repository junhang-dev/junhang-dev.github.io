---
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = [
  {
    category: 'Industrial AI',
    title: '제조·플랜트 현장의 Physical AI, 실제로는 어디까지 와 있을까?',
    summary: '시연 영상 너머, 로봇이 찍은 데이터가 플랜트 보안망을 거쳐 실제 설비 점검 업무로 이어지기까지의 구조',
    date: '2026.10.28',
    href: '/posts/01-physical-ai-in-plants',
  },
  {
    category: 'Essay',
    title: '5년 차 엔지니어의 회고, 그리고 기록의 시작',
    summary: '정유·석유화학 플랜트 현장에서 디지털과 AI를 다루며 느낀 점과 앞으로의 공부 기록',
    date: '2026.10.28',
    href: '/posts/00-prologue',
  },
];
---

<BaseLayout title="아티클" activeNav="home">
  <style>
    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 48px 24px;
    }
    .page-header {
      margin-bottom: 40px;
      padding-bottom: 28px;
      border-bottom: 1px solid var(--grey100);
    }
    .page-header h1 {
      font-size: 32px;
      font-weight: 800;
      letter-spacing: -0.6px;
      margin: 0 0 10px;
      color: var(--grey900);
    }
    .page-header p {
      font-size: 16.5px;
      color: var(--grey600);
      margin: 0;
      line-height: 1.6;
    }
    .section-label {
      font-size: 15px;
      font-weight: 700;
      color: var(--grey700);
      margin: 0 0 20px;
    }
    .article-list {
      display: flex;
      flex-direction: column;
    }
    .article-item {
      display: block;
      padding: 28px 0;
      border-bottom: 1px solid var(--grey100);
      transition: opacity 0.15s ease;
    }
    .article-item:first-child {
      padding-top: 8px;
    }
    .article-item:hover .article-title {
      color: var(--blue500);
    }
    .article-cat {
      font-size: 13.5px;
      font-weight: 700;
      color: var(--blue500);
      margin-bottom: 8px;
    }
    .article-title {
      font-size: 22px;
      font-weight: 800;
      color: var(--grey900);
      margin: 0 0 8px;
      letter-spacing: -0.4px;
      transition: color 0.15s ease;
    }
    .article-summary {
      font-size: 16px;
      color: var(--grey600);
      margin: 0 0 12px;
      line-height: 1.6;
    }
    .article-meta {
      font-size: 13.5px;
      color: var(--grey500);
    }
  </style>

  <div class="container">
    <div class="page-header">
      <h1>junhang.dev</h1>
      <p>디지털 서비스의 구조와 산업 현장의 AI 엔지니어링을 공부하고 기록합니다.</p>
    </div>

    <div class="section-label">전체 아티클</div>
    <div class="article-list">
      {posts.map((post) => (
        <a class="article-item" href={post.href}>
          <div class="article-cat">{post.category}</div>
          <h2 class="article-title">{post.title}</h2>
          <p class="article-summary">{post.summary}</p>
          <div class="article-meta">이준행 · {post.date}</div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
