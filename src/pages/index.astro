---
import BaseLayout from '../layouts/BaseLayout.astro';

const episodes = [
  {
    ep: 'EP.00',
    title: '도로시 본은 계산기를 두려워하지 않았다',
    subtitle: '5년 차 플랜트 엔지니어가 세상의 디지털 서비스를 해부하기로 한 이유',
    date: '2026.10.28',
    href: '/posts/00-prologue',
    published: true,
    tag: '프롤로그 · 에세이',
    color: '#eef4ff',
  },
  {
    ep: 'EP.01',
    title: '토스 FDS: 0.3초 안에 사기를 잡는 법',
    subtitle: 'Rule 엔진 vs 실시간 ML, 그리고 Precision과 Recall의 비대칭 비용',
    date: '연재 예정',
    href: '#',
    published: false,
    tag: '핀테크 · 실시간 추론',
    color: '#fde8dc',
  },
  {
    ep: 'EP.02',
    title: '배민 ETA: "도착 예정 23분"의 이면',
    subtitle: 'Online vs Offline Feature Store와 비 오는 날의 Concept Drift',
    date: '연재 예정',
    href: '#',
    published: false,
    tag: '물류 · Feature Store',
    color: '#dff5ee',
  },
  {
    ep: 'EP.03',
    title: '당근·무신사 검색: 내 마음을 읽는 검색창',
    subtitle: 'BM25 키워드 검색과 Vector 검색의 결합, 그리고 Reranker Trade-off',
    date: '연재 예정',
    href: '#',
    published: false,
    tag: '검색 · Hybrid RAG',
    color: '#ebe7fb',
  },
  {
    ep: 'EP.04',
    title: '플랜트 ①: 1,000개 공정 센서와 운전원 설득하기',
    subtitle: '물리적 지연(Dead-time) 피처 엔지니어링과 SHAP 설명가능성(XAI)',
    date: '연재 예정',
    href: '#',
    published: false,
    tag: '제조 AI · 시계열 최적화',
    color: '#fff4d1',
  },
  {
    ep: 'EP.05',
    title: '플랜트 ②: 결함을 놓치지 않는 배관 RT 판독 AI',
    subtitle: 'Recall 최우선 임계값 설정과 사내 기간계 연동 Human-in-the-Loop',
    date: '연재 예정',
    href: '#',
    published: false,
    tag: '컴퓨터 비전 · MLOps',
    color: '#eef4ff',
  },
  {
    ep: 'EP.06',
    title: '플랜트 ③: 설비 견적 에이전트에서 Graph RAG를 버린 이유',
    subtitle: 'Neo4j 폐기 결정, 구조 보존 청킹과 LangGraph 멀티턴 역질문 아키텍처',
    date: '연재 예정',
    href: '#',
    published: false,
    tag: 'Agentic RAG · 아키텍처',
    color: '#dff5ee',
  },
  {
    ep: 'EP.07',
    title: 'Physical AI: 드론이 날아도 데이터는 SD카드에 갇혀 있다',
    subtitle: '24시간 스트리밍 환상 vs 플랜트 보안·도크(Dock) 배치 파이프라인과 SAP PM 연동',
    date: '연재 예정',
    href: '#',
    published: false,
    tag: 'Physical AI · 로봇/드론',
    color: '#ebe7fb',
  },
];
---

<BaseLayout title="이면 해부학 — 세상의 디지털 서비스와 플랜트 AI 해부" activeNav="home">
  <style>
    .home-hero {
      max-width: 1040px;
      margin: 0 auto;
      padding: 56px 24px 36px;
    }
    .hero-banner {
      background: linear-gradient(135deg, #f3f7ff 0%, #f8f5ff 100%);
      border: 1px solid #e4ecff;
      border-radius: 28px;
      padding: 44px 40px;
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 32px;
      align-items: center;
    }
    @media (max-width: 780px) {
      .hero-banner {
        grid-template-columns: 1fr;
        padding: 32px 24px;
      }
    }
    .hero-tag {
      display: inline-block;
      font-size: 13px;
      font-weight: 700;
      color: var(--blue500);
      background: #ffffff;
      padding: 6px 12px;
      border-radius: 999px;
      margin-bottom: 16px;
      box-shadow: 0 2px 8px rgba(49, 130, 246, 0.08);
    }
    .hero-title {
      font-size: 34px;
      line-height: 1.34;
      font-weight: 800;
      letter-spacing: -0.7px;
      margin: 0 0 14px;
    }
    .hero-desc {
      font-size: 16.5px;
      line-height: 1.65;
      color: var(--grey700);
      margin: 0 0 24px;
    }
    .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--blue500);
      color: #fff;
      font-weight: 700;
      font-size: 15px;
      padding: 13px 22px;
      border-radius: 12px;
      transition: background 0.15s ease;
    }
    .hero-cta:hover {
      background: var(--blue600);
    }
    .framework-box {
      background: #ffffff;
      border-radius: 20px;
      padding: 24px;
      border: 1px solid var(--grey200);
    }
    .framework-box h3 {
      margin: 0 0 14px;
      font-size: 15px;
      color: var(--grey700);
      font-weight: 700;
    }
    .fw-step {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 0;
      border-bottom: 1px solid var(--grey100);
      font-size: 14.5px;
      font-weight: 600;
      color: var(--grey800);
    }
    .fw-step:last-child {
      border-bottom: 0;
    }
    .fw-num {
      width: 24px;
      height: 24px;
      border-radius: 8px;
      background: var(--blue50);
      color: var(--blue500);
      font-size: 12px;
      font-weight: 800;
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }
    .section-wrap {
      max-width: 1040px;
      margin: 0 auto;
      padding: 24px 24px 0;
    }
    .section-title {
      font-size: 22px;
      font-weight: 800;
      margin: 0 0 20px;
      letter-spacing: -0.3px;
    }
    .post-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .post-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 26px 28px;
      border-radius: 20px;
      border: 1px solid var(--grey200);
      background: #fff;
      transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    }
    .post-card.published:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(25, 31, 40, 0.06);
      border-color: var(--blue500);
    }
    .post-card.upcoming {
      opacity: 0.72;
      background: var(--grey50);
    }
    .card-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
    }
    .ep-badge {
      font-size: 12.5px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 999px;
      color: var(--grey800);
    }
    .tag-text {
      font-size: 13px;
      font-weight: 600;
      color: var(--grey600);
    }
    .card-title {
      font-size: 21px;
      font-weight: 800;
      margin: 0 0 6px;
      color: var(--grey900);
      letter-spacing: -0.3px;
    }
    .card-sub {
      font-size: 15px;
      color: var(--grey600);
      margin: 0;
      line-height: 1.5;
    }
    .card-right {
      flex-shrink: 0;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--blue500);
    }
    .post-card.upcoming .card-right {
      color: var(--grey500);
      font-weight: 600;
    }
  </style>

  <section class="home-hero">
    <div class="hero-banner">
      <div>
        <span class="hero-tag">시리즈 연재 · 세상의 디지털 서비스 이면 해부하기</span>
        <h1 class="hero-title">
          매일 쓰는 앱부터 플랜트 로봇까지,<br />기술의 Trade-off를 해부합니다
        </h1>
        <p class="hero-desc">
          5년 차 정유·석유화학 플랜트 AI 엔지니어의 시각으로 토스 FDS, 배민 ETA, 당근 검색, 그리고 현장 Physical AI의 아키텍처 이면을 파헤칩니다.
        </p>
        <a class="hero-cta" href="/posts/00-prologue">
          EP.00 프롤로그 읽기 →
        </a>
      </div>
      <div class="framework-box">
        <h3>🔍 모든 글을 관통하는 4단계 해부 프레임워크</h3>
        <div class="fw-step">
          <span class="fw-num">1</span>
          <span>진짜 문제 재정의 (표면적 문제 vs 핵심 비용)</span>
        </div>
        <div class="fw-step">
          <span class="fw-num">2</span>
          <span>아키텍처 Trade-off (무엇을 포기하고 무엇을 얻었나)</span>
        </div>
        <div class="fw-step">
          <span class="fw-num">3</span>
          <span>레거시 연동 & 가드레일 (SAP·보안·현장 수용성)</span>
        </div>
        <div class="fw-step">
          <span class="fw-num">4</span>
          <span>나만의 한 줄 용어 정의 + 개념 카드 & 현장 노트</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-wrap">
    <h2 class="section-title">전체 에피소드</h2>
    <div class="post-list">
      {episodes.map((item) => (
        <a
          href={item.href}
          class={`post-card ${item.published ? 'published' : 'upcoming'}`}
        >
          <div>
            <div class="card-meta">
              <span class="ep-badge" style={`background:${item.color}`}>{item.ep}</span>
              <span class="tag-text">{item.tag}</span>
            </div>
            <h3 class="card-title">{item.title}</h3>
            <p class="card-sub">{item.subtitle}</p>
          </div>
          <div class="card-right">
            {item.published ? '읽어보기 →' : '연재 예정'}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
