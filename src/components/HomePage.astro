---
import BaseLayout from '../layouts/BaseLayout.astro';
import { posts, ui, type Lang } from '../data/posts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const prefix = lang === 'en' ? '/en' : '';
const alt = lang === 'en' ? '/' : '/en/';
---

<BaseLayout title={t.articles} description={t.siteDescription} lang={lang} alt={alt} activeNav="home">
  <style>
    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 48px 24px;
    }
    .page-header {
      margin-bottom: 40px;
      padding-bottom: 28px;
      border-bottom: 1px solid var(--grey100);
    }
    .page-header h1 {
      font-size: 32px;
      font-weight: 800;
      letter-spacing: -0.6px;
      margin: 0 0 10px;
      color: var(--grey900);
    }
    .page-header p {
      font-size: 16.5px;
      color: var(--grey600);
      margin: 0;
      line-height: 1.6;
    }
    .section-label {
      font-size: 15px;
      font-weight: 700;
      color: var(--grey700);
      margin: 0 0 20px;
    }
    .article-item {
      display: block;
      padding: 28px 0;
      border-bottom: 1px solid var(--grey100);
    }
    .article-item:first-child {
      padding-top: 8px;
    }
    .article-item:hover .article-title {
      color: var(--blue500);
    }
    .article-cat {
      font-size: 13.5px;
      font-weight: 700;
      color: var(--blue500);
      margin-bottom: 8px;
    }
    .article-title {
      font-size: 22px;
      font-weight: 800;
      color: var(--grey900);
      margin: 0 0 8px;
      letter-spacing: -0.4px;
      transition: color 0.15s ease;
    }
    .article-summary {
      font-size: 16px;
      color: var(--grey600);
      margin: 0 0 12px;
      line-height: 1.6;
    }
    .article-meta {
      font-size: 13.5px;
      color: var(--grey500);
    }
  </style>

  <div class="container">
    <div class="page-header">
      <h1>junhang.dev</h1>
      <p>{t.tagline}</p>
    </div>

    <div class="section-label">{t.allArticles}</div>
    <div>
      {posts.map((post) => (
        <a class="article-item" href={`${prefix}/posts/${post.slug}/`}>
          <div class="article-cat">{post.category}</div>
          <h2 class="article-title">{post[lang].title}</h2>
          <p class="article-summary">{post[lang].summary}</p>
          <div class="article-meta">{t.author} · {post.date}</div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
