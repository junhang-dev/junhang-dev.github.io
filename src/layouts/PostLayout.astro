---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.subtitle} activeNav="home">
  <style is:global>
    .post-hero {
      max-width: 760px;
      margin: 0 auto;
      padding: 48px 24px 0;
    }
    .post-thumb {
      border-radius: 24px;
      overflow: hidden;
      margin-bottom: 36px;
      border: 1px solid var(--grey100);
    }
    .post-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 700;
      color: var(--blue500);
      background: var(--blue50);
      padding: 6px 12px;
      border-radius: 999px;
      margin-bottom: 16px;
    }
    h1.post-title {
      font-size: 38px;
      line-height: 1.32;
      font-weight: 800;
      letter-spacing: -0.8px;
      margin: 0 0 14px;
      color: var(--grey900);
    }
    .post-subtitle {
      font-size: 19px;
      line-height: 1.6;
      color: var(--grey700);
      margin: 0 0 28px;
    }
    .post-author {
      display: flex;
      align-items: center;
      gap: 12px;
      padding-bottom: 28px;
      border-bottom: 1px solid var(--grey100);
    }
    .post-avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--lilac);
      display: grid;
      place-items: center;
      font-weight: 800;
      color: #5b4bc4;
    }
    .post-author .name {
      font-size: 15px;
      font-weight: 700;
    }
    .post-author .meta {
      font-size: 13px;
      color: var(--grey500);
      margin-top: 2px;
    }
    .post-status {
      margin-left: auto;
      font-size: 12px;
      font-weight: 700;
      color: #b7791f;
      background: var(--butter);
      padding: 5px 12px;
      border-radius: 999px;
    }
    article.post-body {
      max-width: 760px;
      margin: 0 auto;
      padding: 40px 24px 80px;
      font-size: 17.5px;
      line-height: 1.85;
      color: var(--grey800);
    }
    article.post-body h2 {
      font-size: 25px;
      line-height: 1.42;
      color: var(--grey900);
      font-weight: 800;
      letter-spacing: -0.4px;
      margin: 56px 0 18px;
    }
    article.post-body h3 {
      font-size: 20px;
      color: var(--grey900);
      font-weight: 700;
      margin: 36px 0 12px;
    }
    article.post-body p {
      margin: 0 0 22px;
    }
    article.post-body strong {
      color: var(--grey900);
      font-weight: 700;
    }
    article.post-body ul,
    article.post-body ol {
      padding-left: 22px;
      margin: 0 0 24px;
    }
    article.post-body li {
      margin: 6px 0;
    }
    article.post-body hr {
      border: 0;
      border-top: 1px solid var(--grey100);
      margin: 44px 0;
    }
    article.post-body blockquote {
      margin: 28px 0;
      padding: 20px 24px;
      background: var(--grey50);
      border-left: 4px solid var(--blue500);
      border-radius: 12px;
      color: var(--grey700);
      font-size: 16px;
    }
    article.post-body blockquote p:last-child {
      margin-bottom: 0;
    }
    article.post-body table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin: 28px 0;
      font-size: 15.5px;
      border: 1px solid var(--grey200);
      border-radius: 14px;
      overflow: hidden;
    }
    article.post-body th {
      background: var(--grey50);
      color: var(--grey700);
      font-weight: 700;
      text-align: left;
      padding: 13px 16px;
      border-bottom: 1px solid var(--grey200);
    }
    article.post-body td {
      padding: 13px 16px;
      border-bottom: 1px solid var(--grey100);
      vertical-align: top;
    }
    article.post-body tr:last-child td {
      border-bottom: 0;
    }
    article.post-body img {
      max-width: 100%;
      border-radius: 16px;
      border: 1px solid var(--grey200);
      margin: 16px 0;
    }
  </style>

  <section class="post-hero">
    <div class="post-thumb">
      <svg viewBox="0 0 760 320" width="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="썸네일">
        <rect width="760" height="320" fill="#eef4ff" />
        <circle cx="640" cy="60" r="120" fill="#ebe7fb" />
        <circle cx="90" cy="280" r="110" fill="#dff5ee" />
        <g transform="translate(150,75)">
          <rect width="170" height="190" rx="18" fill="#fff" />
          <rect x="24" y="34" width="110" height="10" rx="5" fill="#e5e8eb" />
          <rect x="24" y="62" width="122" height="10" rx="5" fill="#e5e8eb" />
          <rect x="24" y="90" width="90" height="10" rx="5" fill="#e5e8eb" />
          <rect x="24" y="118" width="116" height="10" rx="5" fill="#e5e8eb" />
          <rect x="24" y="146" width="60" height="22" rx="11" fill="#fde8dc" />
        </g>
        <g transform="translate(345,165)">
          <rect width="70" height="8" rx="4" fill="#3182f6" opacity=".35" />
          <path d="M66 -10 L90 4 L66 18 Z" fill="#3182f6" opacity=".55" />
        </g>
        <g transform="translate(450,85)">
          <rect width="190" height="130" rx="16" fill="#fff" />
          <rect x="20" y="26" width="70" height="10" rx="5" fill="#3182f6" opacity=".7" />
          <rect x="100" y="26" width="60" height="10" rx="5" fill="#ebe7fb" />
          <rect x="36" y="50" width="100" height="10" rx="5" fill="#dff5ee" />
          <rect x="36" y="74" width="120" height="10" rx="5" fill="#fff4d1" />
          <rect x="20" y="98" width="50" height="10" rx="5" fill="#3182f6" opacity=".4" />
          <rect x="-16" y="138" width="222" height="16" rx="8" fill="#d6e4ff" />
        </g>
      </svg>
    </div>
    <div class="post-eyebrow">{frontmatter.series} · EP.{frontmatter.episode}</div>
    <h1 class="post-title">{frontmatter.title}</h1>
    <p class="post-subtitle">{frontmatter.subtitle}</p>
    <div class="post-author">
      <div class="post-avatar">준</div>
      <div>
        <div class="name">이준행 (Junhang Lee)</div>
        <div class="meta">Industrial & Production AI Engineer · {frontmatter.date}</div>
      </div>
      {frontmatter.status && <div class="post-status">{frontmatter.status}</div>}
    </div>
  </section>

  <article class="post-body">
    <slot />
  </article>
</BaseLayout>
