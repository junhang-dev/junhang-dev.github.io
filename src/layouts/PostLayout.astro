---
import BaseLayout from './BaseLayout.astro';
import { ui } from '../data/posts';

const { frontmatter, headings = [] } = Astro.props;
const lang = frontmatter.lang === 'en' ? 'en' : 'ko';
const t = ui[lang];
const toc = headings.filter((h: { depth: number }) => h.depth === 2 || h.depth === 3);
const isoDate = String(frontmatter.date).replaceAll('.', '-');
const site = Astro.site!;
const url = new URL(Astro.url.pathname, site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: frontmatter.title,
  description: frontmatter.subtitle,
  inLanguage: lang === 'ko' ? 'ko-KR' : 'en-US',
  datePublished: isoDate,
  dateModified: isoDate,
  mainEntityOfPage: url,
  image: new URL('/og-default.png', site).href,
  articleSection: frontmatter.category,
  author: {
    '@type': 'Person',
    name: 'Junhang Lee',
    alternateName: '이준행',
    url: site.href,
    sameAs: ['https://github.com/junhang-dev'],
  },
  publisher: { '@type': 'Person', name: 'Junhang Lee', url: site.href },
};
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.subtitle}
  lang={lang}
  alt={frontmatter.alt}
  activeNav="home"
  type="article"
  jsonLd={jsonLd}
>
  <style is:global>
    .article-shell {
      max-width: 1080px;
      margin: 0 auto;
      padding: 56px 24px 80px;
      display: grid;
      grid-template-columns: minmax(0, 700px) 240px;
      justify-content: space-between;
      gap: 48px;
      align-items: start;
    }
    @media (max-width: 980px) {
      .article-shell {
        grid-template-columns: minmax(0, 700px);
        justify-content: center;
      }
      .article-toc-aside {
        display: none;
      }
    }
    .post-hero {
      margin-bottom: 36px;
    }
    .post-category {
      display: inline-block;
      font-size: 14px;
      font-weight: 700;
      color: var(--blue500);
      margin-bottom: 12px;
    }
    h1.post-title {
      font-size: 38px;
      line-height: 1.32;
      font-weight: 800;
      letter-spacing: -0.8px;
      margin: 0 0 14px;
      color: var(--grey900);
    }
    @media (max-width: 640px) {
      h1.post-title {
        font-size: 29px;
      }
    }
    .post-subtitle {
      font-size: 18px;
      line-height: 1.6;
      color: var(--grey600);
      margin: 0 0 24px;
    }
    .post-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 14px;
      color: var(--grey500);
      padding-bottom: 24px;
      border-bottom: 1px solid var(--grey100);
    }
    .post-meta strong {
      color: var(--grey800);
      font-weight: 600;
    }
    article.post-body {
      font-size: 17px;
      line-height: 1.8;
      color: var(--grey800);
      letter-spacing: -0.1px;
    }
    article.post-body h2 {
      font-size: 25px;
      line-height: 1.4;
      color: var(--grey900);
      font-weight: 800;
      letter-spacing: -0.4px;
      margin: 56px 0 16px;
      scroll-margin-top: 84px;
    }
    article.post-body h3 {
      font-size: 19.5px;
      line-height: 1.45;
      color: var(--grey900);
      font-weight: 700;
      margin: 36px 0 12px;
      scroll-margin-top: 84px;
    }
    article.post-body p {
      margin: 0 0 22px;
    }
    article.post-body strong {
      color: var(--grey900);
      font-weight: 700;
    }
    article.post-body a {
      color: var(--blue500);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    article.post-body ul,
    article.post-body ol {
      padding-left: 22px;
      margin: 0 0 24px;
    }
    article.post-body li {
      margin: 7px 0;
    }
    article.post-body hr {
      border: 0;
      border-top: 1px solid var(--grey100);
      margin: 48px 0;
    }
    article.post-body blockquote {
      margin: 28px 0;
      padding: 18px 22px;
      background: var(--grey50);
      border-left: 3px solid var(--blue500);
      border-radius: 10px;
      color: var(--grey700);
      font-size: 16px;
    }
    article.post-body blockquote p:last-child {
      margin-bottom: 0;
    }
    article.post-body figure {
      margin: 34px 0;
    }
    article.post-body figure img,
    article.post-body img {
      width: 100%;
      height: auto;
      border-radius: 16px;
      border: 1px solid var(--grey200);
      display: block;
    }
    article.post-body figcaption {
      margin-top: 12px;
      font-size: 13.5px;
      color: var(--grey500);
      text-align: center;
      line-height: 1.55;
    }
    article.post-body pre {
      padding: 18px 20px;
      border-radius: 12px;
      border: 1px solid var(--grey200);
      background: var(--grey50) !important;
      overflow-x: auto;
      font-size: 14px;
      line-height: 1.65;
      margin: 24px 0;
    }
    article.post-body :not(pre) > code {
      background: var(--grey100);
      padding: 2px 6px;
      border-radius: 5px;
      font-size: 0.9em;
    }
    .post-actions {
      margin-top: 56px;
      padding-top: 28px;
      border-top: 1px solid var(--grey100);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }
    .share-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--grey200);
      background: #ffffff;
      color: var(--grey700);
      font-family: inherit;
      font-size: 14px;
      font-weight: 600;
      padding: 9px 16px;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .share-btn:hover {
      border-color: var(--blue500);
      color: var(--blue500);
      background: var(--blue50);
    }
    .article-toc-aside {
      position: sticky;
      top: 96px;
      padding-left: 16px;
      border-left: 1px solid var(--grey200);
    }
    .toc-title {
      font-size: 12.5px;
      font-weight: 700;
      color: var(--grey500);
      letter-spacing: 0.4px;
      margin-bottom: 12px;
    }
    .toc-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 9px;
    }
    .toc-list a {
      display: block;
      font-size: 13.5px;
      line-height: 1.45;
      color: var(--grey500);
      font-weight: 500;
      transition: color 0.15s ease;
    }
    .toc-list a:hover {
      color: var(--blue500);
      font-weight: 700;
    }
    .toc-list li.toc-h3 {
      padding-left: 10px;
    }
  </style>

  <div class="article-shell">
    <div>
      <section class="post-hero">
        {frontmatter.category && <div class="post-category">{frontmatter.category}</div>}
        <h1 class="post-title">{frontmatter.title}</h1>
        {frontmatter.subtitle && <p class="post-subtitle">{frontmatter.subtitle}</p>}
        <div class="post-meta">
          <div>
            <strong>{t.author}</strong>
            <span> · <time datetime={isoDate}>{frontmatter.date}</time></span>
          </div>
        </div>
      </section>

      <article class="post-body">
        <slot />
      </article>

      <div class="post-actions">
        <button type="button" class="share-btn" id="copy-link-btn" data-copied={t.copied}>{t.copy}</button>
      </div>
    </div>

    <aside class="article-toc-aside" aria-label={t.toc}>
      <div class="toc-title">{t.toc}</div>
      <ul class="toc-list">
        {toc.map((h: { depth: number; slug: string; text: string }) => (
          <li class={h.depth === 3 ? 'toc-h3' : ''}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </aside>
  </div>

  <script is:inline>
    var copyBtn = document.getElementById('copy-link-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(window.location.href);
        copyBtn.textContent = copyBtn.getAttribute('data-copied');
      });
    }
  </script>
</BaseLayout>
