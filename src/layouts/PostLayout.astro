---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.subtitle} activeNav="home">
  <style is:global>
    .post-hero {
      max-width: 720px;
      margin: 0 auto;
      padding: 56px 24px 0;
    }
    .post-category {
      display: inline-block;
      font-size: 14px;
      font-weight: 700;
      color: var(--blue500);
      margin-bottom: 12px;
    }
    h1.post-title {
      font-size: 36px;
      line-height: 1.35;
      font-weight: 800;
      letter-spacing: -0.8px;
      margin: 0 0 14px;
      color: var(--grey900);
    }
    .post-subtitle {
      font-size: 18px;
      line-height: 1.6;
      color: var(--grey600);
      margin: 0 0 28px;
    }
    .post-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      color: var(--grey500);
      padding-bottom: 28px;
      border-bottom: 1px solid var(--grey100);
    }
    .post-meta strong {
      color: var(--grey800);
      font-weight: 600;
    }
    article.post-body {
      max-width: 720px;
      margin: 0 auto;
      padding: 40px 24px 80px;
      font-size: 17px;
      line-height: 1.85;
      color: var(--grey800);
    }
    article.post-body h2 {
      font-size: 24px;
      line-height: 1.42;
      color: var(--grey900);
      font-weight: 800;
      letter-spacing: -0.4px;
      margin: 52px 0 16px;
    }
    article.post-body h3 {
      font-size: 19px;
      color: var(--grey900);
      font-weight: 700;
      margin: 34px 0 12px;
    }
    article.post-body p {
      margin: 0 0 22px;
    }
    article.post-body strong {
      color: var(--grey900);
      font-weight: 700;
    }
    article.post-body ul,
    article.post-body ol {
      padding-left: 22px;
      margin: 0 0 24px;
    }
    article.post-body li {
      margin: 6px 0;
    }
    article.post-body hr {
      border: 0;
      border-top: 1px solid var(--grey100);
      margin: 44px 0;
    }
    article.post-body blockquote {
      margin: 28px 0;
      padding: 18px 22px;
      background: var(--grey50);
      border-left: 3px solid var(--blue500);
      border-radius: 8px;
      color: var(--grey700);
      font-size: 16px;
    }
    article.post-body blockquote p:last-child {
      margin-bottom: 0;
    }
  </style>

  <section class="post-hero">
    {frontmatter.category && <div class="post-category">{frontmatter.category}</div>}
    <h1 class="post-title">{frontmatter.title}</h1>
    {frontmatter.subtitle && <p class="post-subtitle">{frontmatter.subtitle}</p>}
    <div class="post-meta">
      <strong>이준행</strong>
      <span>·</span>
      <span>{frontmatter.date}</span>
    </div>
  </section>

  <article class="post-body">
    <slot />
  </article>
</BaseLayout>
